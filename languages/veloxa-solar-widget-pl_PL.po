msgid "Your device, Home Assistant automation or script sends readings to this site. Recommended for most externally hosted WordPress sites."
msgstr "Twoje urządzenie, automatyzacja Home Assistant lub skrypt wysyła odczyty do tej witryny. Polecane dla większości witryn WordPress w hostingu zewnętrznym."

msgid "Read selected solar sensors from a Home Assistant instance that your WordPress server can reach."
msgstr "Odczytuj wybrane czujniki instalacji solarnej z Home Assistanta dostępnego dla serwera WordPress."

msgid "Map values from any JSON API and choose the units it uses."
msgstr "Mapuj wartości z dowolnego API JSON i wybierz używane jednostki."

msgid "Connect directly to SolaxCloud. This integration is in beta."
msgstr "Połącz bezpośrednio z SolaxCloud. Ta integracja jest w wersji beta."

msgid "Choose a data source below, then follow its setup form."
msgstr "Wybierz poniżej źródło danych i wypełnij formularz konfiguracji."

msgid "No connections yet. Add a source to start displaying your solar data."
msgstr "Nie ma jeszcze połączeń. Dodaj źródło, aby wyświetlać dane instalacji solarnej."

msgid "Setup required"
msgstr "Wymaga konfiguracji"

msgid "Last refresh failed"
msgstr "Ostatnie odświeżenie nie powiodło się"

msgid "Waiting for first reading"
msgstr "Oczekiwanie na pierwszy odczyt"

msgid "Data is out of date"
msgstr "Dane są nieaktualne"

msgid "Data is up to date"
msgstr "Dane są aktualne"

msgid "New sources are private by default. You can choose separately whether to show their data on public pages."
msgstr "Nowe źródła są domyślnie prywatne. Możesz osobno zdecydować, czy wyświetlać ich dane na stronach publicznych."

msgid "Change source type"
msgstr "Zmień typ źródła"

msgid "Changing source type will discard unsaved entries."
msgstr "Zmiana typu źródła spowoduje utratę niezapisanych wpisów."

msgid "Your non-secret entries were restored. For your security, enter passwords and tokens again."
msgstr "Przywrócono wpisane wartości, które nie są sekretami. Ze względów bezpieczeństwa wpisz ponownie hasła i tokeny."

msgid "Connect a SolarEdge installation using an API key from the monitoring portal."
msgstr "Połącz instalację SolarEdge za pomocą klucza API z portalu monitoringu."

msgid "Connect to an inverter monitored in the Solarman cloud using your OpenAPI account."
msgstr "Połącz falownik monitorowany w chmurze Solarman za pomocą konta OpenAPI."

