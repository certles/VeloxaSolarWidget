msgid "The %s didn't work as expected"
msgstr "Ten produkt nie działał zgodnie z oczekiwaniami%.0s"

msgid "What did you expect?"
msgstr "Czego się spodziewałeś?"

msgid "You have purchased a %s license."
msgstr "Kupiłeś licencję %s."

msgid " The %s's %sdownload link%s, license key, and installation instructions have been sent to %s. If you can't find the email after 5 min, please check your spam box."
msgstr " %s — %sLink do pobrania%s, klucz licencyjny i instrukcja instalacji zostały wysłane na adres %s. Jeśli po 5 minutach nie widzisz wiadomości, sprawdź folder spam."

msgctxt "interjection expressing joy or exuberance"
msgid "Yee-haw"
msgstr "Hurra"

msgctxt "addonX cannot run without pluginY"
msgid "%s cannot run without %s."
msgstr "%s nie może działać bez %s."

msgctxt "addonX cannot run..."
