msgstr "rozpocząć okres próbny"

msgid "complete the opt-in"
msgstr "dokończyć wyrażanie zgody"

msgid "Thanks!"
msgstr "Dziękujemy!"

msgid "You are just one step away - %s"
msgstr "Został tylko jeden krok — %s"

msgctxt "%s - plugin name. As complete \"PluginX\" activation now"
